upstream brand_dna  { server brand-dna:8000; }
upstream campaigns  { server campaigns-api:8000; }
upstream ads        { server ads:8000; }
upstream webdev     { server webdev-api:8000; }

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 200M;
    proxy_read_timeout   300s;
    proxy_send_timeout   300s;

    # ── Brand DNA Service ──────────────────────────────────────────────────
    # Strip /api/brand/ → /api/ so backend routes at /api/clients match.
    location /api/brand/ {
        proxy_pass         http://brand_dna/api/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── Campaign Director API + WebSocket ──────────────────────────────────
    location /api/campaigns/ {
        proxy_pass         http://campaigns;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass             http://campaigns;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade           $http_upgrade;
        proxy_set_header       Connection        $connection_upgrade;
        proxy_set_header       Host              $host;
        proxy_set_header       X-Real-IP         $remote_addr;
        proxy_read_timeout     3600s;
        proxy_send_timeout     3600s;
    }

    # ── Google Ads Agent ───────────────────────────────────────────────────
    # Strip /api/ads/ → / so backend routes at /accounts match.
    location /api/ads/ {
        proxy_pass         http://ads/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── WebDev Agent (nginx injects the API key server-side) ───────────────
    location /api/webdev/ {
        proxy_pass         http://webdev;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-API-Key         ${WEBDEV_SECRET_KEY};
    }

    # ── MinIO media (logo uploads) ────────────────────────────────────────
    location /media/ {
        proxy_pass         http://minio:9000/;
        proxy_set_header   Host              minio;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_buffering    off;
    }

    # ── Internal routes — never exposed to clients ─────────────────────────
    location /internal/ {
        deny all;
        return 403;
    }

    # ── React SPA (must be last) ───────────────────────────────────────────
    location / {
        root  /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}

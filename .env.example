# ──────────────────────────────────────────────────────────────────────────────
# CloudIA AI Orchestra — Root Environment Variables
# Copy to .env and fill in all values before running docker-compose up
# ──────────────────────────────────────────────────────────────────────────────

# ── Shared ────────────────────────────────────────────────────────────────────

# Anthropic Claude — used by Brand DNA, Campaign Director, and WebDev agents
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cross-service authentication secret — must be identical across all services
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-to-a-strong-random-secret

ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-domain.com

# ── Database passwords ────────────────────────────────────────────────────────

POSTGRES_BRAND_PASSWORD=change-me
POSTGRES_CAMPAIGNS_PASSWORD=change-me
POSTGRES_ADS_PASSWORD=change-me
POSTGRES_WEBDEV_PASSWORD=change-me

# ── MinIO (Campaign Director media storage) ───────────────────────────────────

MINIO_ROOT_USER=cloudia
MINIO_ROOT_PASSWORD=change-me-minio-password

# ── Brand DNA Service ─────────────────────────────────────────────────────────
# (No extra vars — uses ANTHROPIC_API_KEY and INTERNAL_API_SECRET above)

# ── Campaign Director ─────────────────────────────────────────────────────────

# Random secret for session/JWT signing — generate with: openssl rand -hex 32
CAMPAIGNS_SECRET_KEY=change-me

# Fernet encryption key for OAuth tokens — generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMPAIGNS_ENCRYPTION_KEY=change-me-fernet-key

# OAuth callback base (used in OAuth redirects)
OAUTH_CALLBACK_BASE_URL=https://your-domain.com/api/campaigns

# Social platform OAuth credentials (all optional at startup)
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Ads Agent ──────────────────────────────────────────────────────────

# Random API key for authenticating frontend → ads service
# Generate with: openssl rand -hex 32
ADS_SECRET_KEY=change-me

# Google Ads API credentials (optional — agent runs without them in demo mode)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ── WebDev Agent ──────────────────────────────────────────────────────────────

# API key for authenticating frontend → webdev service (injected by nginx)
# Generate with: openssl rand -hex 32
WEBDEV_SECRET_KEY=change-me
